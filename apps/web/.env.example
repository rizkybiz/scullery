# Where the server-side API client sends requests. Copy to .env.local for development.
# Server-only: deliberately no NEXT_PUBLIC_ prefix, so it never reaches the browser.
SCULLERY_API_URL=http://localhost:8080

# Only when the API is behind Google Cloud Run's sign-in (see infra/terraform). All four
# or none: these are the Terraform outputs, and they are configuration, not secrets.
# GCP_PROJECT_NUMBER=
# GCP_WORKLOAD_IDENTITY_POOL_ID=
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
# GCP_SERVICE_ACCOUNT_EMAIL=

# Sign-in. AUTH_SECRET signs the session cookie (at least 32 random characters, a different
# value for each environment; changing it signs everyone out). Each user variable is a
# password HASH, never a password; make one with
#   read -rs PW && printf '%s' "$PW" | node scripts/hash-password.ts
# Set READ_ONLY=true to stop all writes (any value but false/0/no/off turns it on).
# READ_ONLY=
# Unset AUTH_USER_REVIEWER_HASH to revoke the reviewer.
# AUTH_SECRET=
# AUTH_USER_ADMIN_HASH=
# AUTH_USER_REVIEWER_HASH=
