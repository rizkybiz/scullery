#!/usr/bin/env bash
# Runs against what is actually staged (not the working tree), so a commit is
# only accepted if the exact snapshot being committed typechecks, lints and
# passes its tests. That is what keeps each commit atomic and bisectable.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

fail() { echo "pre-commit: $1" >&2; exit 1; }

# --- Guards that apply to every commit --------------------------------------
if echo "$staged" | grep -qE '(^|/)\.env$|(^|/)\.env\.(local|prod|production)$'; then
  fail "refusing to commit an .env file (use .env.example for templates)"
fi
if git diff --cached -U0 | grep -qE '^\+.*(BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36})'; then
  fail "staged changes look like they contain a secret (private key / token)"
fi

# --- Frontend checks, only when relevant files changed ------------------------
if ! echo "$staged" | grep -qE '\.(ts|tsx|js|jsx|css|html)$|^package(-lock)?\.json$|^(vite|tsconfig|eslint)[^/]*$'; then
  exit 0
fi
[ -f package.json ] || exit 0   # nothing scaffolded yet

[ -d "$root/node_modules" ] || fail "node_modules missing (run: npm ci)"

# Check an exact copy of the index, reusing the installed dependencies.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a -f --prefix="$tmp/"
cd "$tmp"
ln -s "$root/node_modules" node_modules

# Scripts are optional until the project defines them (--if-present).
npm run --if-present typecheck || fail "typecheck failed"
npm run --if-present lint      || fail "lint failed"
npm run --if-present format:check || fail "formatting differs (run: npm run format, then re-stage)"
CI=true npm test --if-present  || fail "tests failed"
