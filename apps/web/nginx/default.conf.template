server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The browser calls same-origin /api/... (no CORS, no URL in the JavaScript).
    # The trailing slash on proxy_pass strips the /api prefix, so
    # /api/healthz reaches the API as /healthz.
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Built assets have content hashes in their names, so they can be cached
    # forever; a new build produces new names.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: any other path serves index.html so client-side routing
    # works on a refresh or a deep link. index.html itself must never be cached,
    # or users keep an old build.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
