{
  "name": "scullery-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "gen:api": "openapi-typescript ../../services/api/openapi.json -o src/lib/api/schema.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.137",
    "@vercel/analytics": "2.0.1",
    "@vercel/oidc": "4.0.9",
    "ai": "7.0.164",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "google-auth-library": "11.3.4",
    "jose": "6.2.18",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "workflow": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "undici": "7.30.2",
    "zod": "$zod",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
