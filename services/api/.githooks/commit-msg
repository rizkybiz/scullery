#!/usr/bin/env bash
# Enforces Conventional Commits on the subject line:
#   type(scope): imperative summary      (<= 72 chars, no trailing period)
set -euo pipefail

msg_file="$1"
lines="$(grep -v '^#' "$msg_file" || true)"
subject="$(printf '%s\n' "$lines" | sed -n '1p')"
second="$(printf '%s\n' "$lines" | sed -n '2p')"

# Messages git generates itself are exempt.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
re="^(${types})(\([a-z0-9._/-]+\))?!?: [^ ].*$"

fail() {
  echo "commit-msg: $1" >&2
  echo "  subject: $subject" >&2
  echo "  expected: type(scope): summary   where type is one of: ${types//|/, }" >&2
  echo "  e.g.      feat(api): add recipe import endpoint" >&2
  exit 1
}

[[ $subject =~ $re ]]        || fail "subject is not a Conventional Commit"
(( ${#subject} <= 72 ))      || fail "subject is ${#subject} chars; limit is 72"
[[ $subject != *. ]]         || fail "subject must not end with a period"
[[ -z $second ]]             || fail "second line must be blank (subject, blank line, then body)"
exit 0
