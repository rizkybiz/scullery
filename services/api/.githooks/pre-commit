#!/usr/bin/env bash
# Runs against what is actually staged (not the working tree), so a commit is
# only accepted if the exact snapshot being committed is formatted, vets and
# passes its tests. That is what keeps each commit atomic and bisectable.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

fail() { echo "pre-commit: $1" >&2; exit 1; }

# --- Guards that apply to every commit --------------------------------------
if echo "$staged" | grep -qE '(^|/)\.env$|(^|/)\.env\.(local|prod|production)$'; then
  fail "refusing to commit an .env file (use .env.example for templates)"
fi
if git diff --cached -U0 | grep -qE '^\+.*(BEGIN [A-Z ]*PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36})'; then
  fail "staged changes look like they contain a secret (private key / token)"
fi

# --- Go checks, only when Go-relevant files changed -------------------------
# migrations/ is embedded in the binary, so it counts.
if ! echo "$staged" | grep -qE '(\.go$|^go\.(mod|sum)$|^migrations/)'; then
  exit 0
fi

unformatted=""
while IFS= read -r f; do
  [[ $f == *.go ]] || continue
  if [ -n "$(git show ":$f" | gofmt -l)" ]; then unformatted+=" $f"; fi
done <<<"$staged"
[ -z "$unformatted" ] || fail "gofmt needed on:$unformatted  (run: gofmt -w$unformatted)"

# Check an exact copy of the index.
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
git checkout-index -a -f --prefix="$tmp/"
cd "$tmp"

go mod tidy -diff >/dev/null 2>&1 || fail "go.mod/go.sum not tidy (run: go mod tidy, then stage them)"
go vet ./...                      || fail "go vet failed"
go test -short ./...              || fail "tests failed"
